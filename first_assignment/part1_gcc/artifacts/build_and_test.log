mkdir -p artifacts
riscv64-unknown-elf-gcc -E  fib.c -o artifacts/fib.i
riscv64-unknown-elf-gcc -S  -O0 -g -fno-pic -mcmodel=medany fib.c -o artifacts/fib.s
riscv64-unknown-elf-gcc -S  -O2 -fno-pic -mcmodel=medany fib.c -o artifacts/fib.O2.s
riscv64-unknown-elf-gcc  -O0 -g -fno-pic -mcmodel=medany -fdump-tree-original -S fib.c -o /dev/null
mv fib.c.*t.original artifacts/fib.c.original
riscv64-unknown-elf-gcc  -O0 -g -fno-pic -mcmodel=medany -fdump-tree-gimple -S fib.c -o /dev/null
mv fib.c.*t.gimple artifacts/fib.c.gimple
riscv64-unknown-elf-gcc  -O0 -g -fno-pic -mcmodel=medany -fdump-rtl-expand -S fib.c -o /dev/null
mv fib.c.*r.expand artifacts/fib.c.rtl-expand
riscv64-unknown-elf-gcc  -O0 -g -fno-pic -mcmodel=medany -fdump-rtl-final -S fib.c -o /dev/null
mv fib.c.*r.final artifacts/fib.c.rtl-final
riscv64-unknown-elf-gcc -march=rv64imafdc -mabi=lp64d -c artifacts/fib.s -o artifacts/fib.o
mkdir -p artifacts/sifive-runtime
riscv64-unknown-elf-gcc -O2 -mcmodel=medany -fno-pic -I../../lib -c ../../lib/sylib.c -o artifacts/sifive-runtime/sylib.o
riscv64-unknown-elf-ar rcs artifacts/sifive-runtime/libsysy_riscv_sifive.a artifacts/sifive-runtime/sylib.o
riscv64-unknown-elf-gcc artifacts/fib.o -o artifacts/fib \
  -Lartifacts/sifive-runtime -lsysy_riscv_sifive \
  -static -mcmodel=medany -Wl,--no-relax,-Ttext=0x90000000
mkdir -p artifacts/tests
TEST_ARTIFACT_DIR=artifacts/tests ./run_tests.sh artifacts/fib \
  > artifacts/tests/results.txt
cat artifacts/tests/results.txt
PASS n=0
PASS n=1
PASS n=5
PASS n=10
file artifacts/fib.o > artifacts/fib_object_info.txt
riscv64-unknown-elf-readelf -h -A -s artifacts/fib.o \
  | sed 's/[[:space:]]\+$//' >> artifacts/fib_object_info.txt
riscv64-unknown-elf-objdump -dr artifacts/fib.o > artifacts/fib_objdump.txt
file artifacts/fib > artifacts/fib_executable_info.txt
riscv64-unknown-elf-readelf -h -A artifacts/fib \
  | sed 's/[[:space:]]\+$//' >> artifacts/fib_executable_info.txt
./environment.sh > artifacts/environment.txt
