mkdir -p artifacts
llvm-as sysy_demo.ll -o artifacts/sysy_demo.bc
llc -march=riscv64 -mattr=+m,+a,+f,+d -filetype=obj artifacts/sysy_demo.bc -o artifacts/sysy_demo.o
riscv64-unknown-elf-gcc -B/home/liuguoquan/.local/opt/riscv-binutils-2.42/driver-bin/ artifacts/sysy_demo.o -o artifacts/sysy_demo \
  -L../../lib -lsysy_riscv \
  -static -mcmodel=medany -Wl,--no-relax,-Ttext=0x90000000
riscv64-unknown-elf-gcc -B/home/liuguoquan/.local/opt/riscv-binutils-2.42/driver-bin/ -march=rv64imafdc_zicsr_zmmul -c sysy_demo_asm.s -o artifacts/sysy_demo_asm.o
riscv64-unknown-elf-gcc -B/home/liuguoquan/.local/opt/riscv-binutils-2.42/driver-bin/ artifacts/sysy_demo_asm.o -o artifacts/sysy_demo_asm \
  -L../../lib -lsysy_riscv \
  -static -mcmodel=medany -Wl,--no-relax,-Ttext=0x90000000
opt -passes=verify sysy_demo.ll -disable-output
mkdir -p artifacts/tests
TEST_ARTIFACT_DIR=artifacts/tests ./run_tests.sh artifacts/sysy_demo \
  > artifacts/tests/reference_results.txt
cat artifacts/tests/reference_results.txt
PASS n=0
PASS n=1
PASS n=3
PASS n=4
PASS n=5
PASS n=10
mkdir -p artifacts/tests_asm
TEST_ARTIFACT_DIR=artifacts/tests_asm ./run_tests.sh artifacts/sysy_demo_asm \
  > artifacts/tests_asm/results.txt
cat artifacts/tests_asm/results.txt
PASS n=0
PASS n=1
PASS n=3
PASS n=4
PASS n=5
PASS n=10
/home/liuguoquan/.local/opt/riscv-binutils-2.42/usr/bin/riscv64-unknown-elf-readelf -h -A -s artifacts/sysy_demo_asm.o \
  | sed 's/[[:space:]]\+$//' > artifacts/sysy_demo_asm_readelf.txt
/home/liuguoquan/.local/opt/riscv-binutils-2.42/usr/bin/riscv64-unknown-elf-objdump -dr artifacts/sysy_demo_asm.o > artifacts/sysy_demo_asm_objdump.txt
